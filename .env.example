# DART OpenAPI (https://opendart.fss.or.kr) — 1 key
DART_API_KEY=your_dart_key

# Anthropic (agents run on Claude)
ANTHROPIC_API_KEY=your_anthropic_key

# Naver 검색 API (뉴스) — needs BOTH the Client ID and the Client Secret.
# 네이버 개발자센터 > 내 애플리케이션 에서 발급. 헤더 X-Naver-Client-Id / X-Naver-Client-Secret.
# NAVER_API_KEY 하나만 있으면 뉴스 인증(401)이 실패하므로 아래 두 개를 채워야 뉴스가 붙습니다.
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
# (호환용) 단일 변수만 쓸 경우 CLIENT_ID로 간주됩니다.
NAVER_API_KEY=your_naver_client_id
